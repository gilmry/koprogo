# KoproGo - déploiement auto-hébergé (docker-compose.prod.yml)
# cp .env.production.example .env, puis éditer avant le premier déploiement.
#
# Générer des secrets forts :
#   POSTGRES_PASSWORD / S3_SECRET_KEY : openssl rand -base64 24
#   JWT_SECRET                        : openssl rand -base64 32   (32+ caractères, diversité vérifiée au boot)
#   TOTP_ENCRYPTION_KEY               : openssl rand -hex 32      (exactement 64 caractères hex)

DOMAIN=koprogo.com
API_DOMAIN=api.koprogo.com
PUBLIC_API_URL=https://api.koprogo.com/api/v1
ACME_EMAIL=admin@koprogo.com

POSTGRES_DB=koprogo_db
POSTGRES_USER=koprogo
POSTGRES_PASSWORD=changeme-generate-with-openssl

JWT_SECRET=changeme-generate-with-openssl-rand-base64-32
TOTP_ENCRYPTION_KEY=changeme-generate-with-openssl-rand-hex-32

CORS_ALLOWED_ORIGINS=https://koprogo.com
RUST_LOG=warn
# IP-based rate limiting (general API + /auth/login brute-force) is enforced
# by Traefik (see labels on the backend service in docker-compose.prod.yml),
# not this app. ENABLE_RATE_LIMITING only gates the GDPR per-user limiter.
ENABLE_RATE_LIMITING=true

S3_BUCKET=koprogo-documents
S3_ACCESS_KEY=koprogo
S3_SECRET_KEY=changeme-generate-with-openssl
