#!/bin/bash
# KoproGo Encrypted Backup Script - managed by Ansible (role: backup)
#
# Dumps PostgreSQL, MinIO metadata and the .env, encrypts them with the
# offline backup PUBLIC key and copies them off-site to S3.
#
# - The private key is NOT on this host: this script cannot decrypt what it
#   writes. Full restore tests run off-host (scripts/tests/test-backup-restore.sh,
#   scripts/pra/full-restore.sh).
# - Plaintext never touches the disk: dumps are streamed into gzip | gpg.
# - A failed off-site upload fails the job and is exported to Prometheus.

set -euo pipefail
umask 077

KOPROGO_DIR="{{ koprogo_dir }}"
BACKUP_DIR="$KOPROGO_DIR/backups"
COMPOSE_FILE="{{ backup_compose_file | default(koprogo_dir ~ '/deploy/production/docker-compose.yml') }}"
ENV_FILE="{{ backup_env_file | default(koprogo_dir ~ '/deploy/production/.env') }}"
PUBKEY_FILE="/etc/koprogo/backup-pubkey.asc"
S3_BUCKET="{{ s3_backup_bucket | default('koprogo-backups') }}"
OFFSITE_REQUIRED="{{ 'true' if (backup_offsite_required | default(true) | bool) else 'false' }}"
METRICS_DIR="/var/lib/node_exporter/textfile_collector"
RETENTION_DAYS="{{ backup_local_retention_days | default(7) }}"

DATE=$(date +%Y%m%d_%H%M%S)
ARTIFACTS=()

mkdir -p "$BACKUP_DIR"

log() { echo "[$(date -Is)] $*"; }

# --- Metrics (node-exporter textfile collector, atomic write) -------------
write_metric() {
    local name="$1" value="$2"
    [ -d "$METRICS_DIR" ] || return 0
    local tmp
    tmp=$(mktemp "$METRICS_DIR/.${name}.XXXXXX")
    echo "${name} ${value}" > "$tmp"
    chmod 0644 "$tmp"
    mv "$tmp" "$METRICS_DIR/${name}.prom"
}

on_exit() {
    local rc=$?
    if [ "$rc" -eq 0 ]; then
        write_metric koprogo_backup_last_run_success 1
    else
        write_metric koprogo_backup_last_run_success 0
        log "Backup FAILED (exit $rc)"
    fi
}
trap on_exit EXIT

# --- Encryption ------------------------------------------------------------
# --recipient-file uses the public key directly: no keyring, no trust model.
encrypt_to() {
    gpg --batch --yes --encrypt \
        --recipient-file "$PUBKEY_FILE" \
        --compress-algo none \
        --output "$1"
}

# Encryption subkey id(s) of the backup public key, used to check that every
# artifact is really encrypted to it (this host cannot decrypt to verify).
expected_keyids() {
    gpg --batch --with-colons --show-keys "$PUBKEY_FILE" 2>/dev/null \
        | awk -F: '$1 == "sub" || $1 == "pub" { print $5 }'
}

verify_encrypted() {
    local file="$1" keyid
    # gpg exits non-zero here by design ("no secret key"): only the packet
    # header is needed, so ignore its status rather than tripping pipefail.
    keyid=$({ gpg --batch --list-packets "$file" 2>&1 || true; } \
        | sed -n 's/.*pubkey enc packet:.*keyid \([0-9A-Fa-f]*\).*/\1/p' | head -1)
    if [ -z "$keyid" ] || ! expected_keyids | grep -qi "^${keyid}$"; then
        log "Integrity check FAILED: $(basename "$file") is not encrypted to the backup key"
        return 1
    fi
    sha256sum "$file" > "$file.sha256"
    ARTIFACTS+=("$file" "$file.sha256")
}

# --- Backups ---------------------------------------------------------------
backup_postgresql() {
    log "Backing up PostgreSQL..."
    local out="$BACKUP_DIR/koprogo_$DATE.sql.gz.gpg"
    docker compose -f "$COMPOSE_FILE" exec -T postgres \
        pg_dump -U koprogo koprogo_db \
        | gzip -9 | encrypt_to "$out"
    verify_encrypted "$out"
    write_metric koprogo_last_backup_timestamp_seconds "$(date +%s)"
    log "PostgreSQL backup: $(basename "$out") ($(du -h "$out" | cut -f1))"
}

backup_minio() {
    if ! command -v mc >/dev/null 2>&1; then
        log "MinIO client (mc) not installed - skipping MinIO metadata"
        return 0
    fi
    if [ -z "${MINIO_ROOT_USER:-}" ] || [ -z "${MINIO_ROOT_PASSWORD:-}" ]; then
        log "MinIO credentials not available - skipping MinIO metadata"
        return 0
    fi
    log "Backing up MinIO metadata..."
    local out="$BACKUP_DIR/minio-metadata_$DATE.json.gz.gpg"
    mc alias set local http://localhost:9000 "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD" >/dev/null
    mc ls local/koprogo-documents --json | gzip -9 | encrypt_to "$out"
    verify_encrypted "$out"
}

backup_env() {
    [ -f "$ENV_FILE" ] || return 0
    log "Backing up .env configuration..."
    local out="$BACKUP_DIR/env_$DATE.gpg"
    encrypt_to "$out" < "$ENV_FILE"
    verify_encrypted "$out"
}

# --- Off-site copy ---------------------------------------------------------
# Immutability is enforced by S3 Object Lock default retention on the bucket.
sync_to_s3() {
    if [ ! -f /root/.s3cfg ]; then
        if [ "$OFFSITE_REQUIRED" = "true" ]; then
            log "Off-site copy REQUIRED but /root/.s3cfg is missing"
            return 1
        fi
        log "Off-site copy disabled for this environment - backups are local only"
        return 0
    fi
    log "Copying {% raw %}${#ARTIFACTS[@]}{% endraw %} artifacts to s3://$S3_BUCKET/$DATE/ ..."
    local f
    for f in "${ARTIFACTS[@]}"; do
        s3cmd --config /root/.s3cfg put --no-preserve "$f" "s3://$S3_BUCKET/$DATE/"
    done
    write_metric koprogo_last_offsite_backup_timestamp_seconds "$(date +%s)"
    log "Off-site copy done"
}

cleanup_old_backups() {
    find "$BACKUP_DIR" -maxdepth 1 -type f \
        \( -name '*.gpg' -o -name '*.gpg.sha256' \) \
        -mtime +"$RETENTION_DAYS" -delete
    log "$(find "$BACKUP_DIR" -maxdepth 1 -name 'koprogo_*.sql.gz.gpg' | wc -l) PostgreSQL backups kept locally"
}

main() {
    log "KoproGo encrypted backup starting"
    [ -s "$PUBKEY_FILE" ] || { log "Missing $PUBKEY_FILE"; exit 1; }

    backup_postgresql
    backup_minio
    backup_env
    sync_to_s3
    cleanup_old_backups

    log "Backup completed. Restore (off-host, with the offline private key):"
    log "  gpg --decrypt koprogo_YYYYMMDD_HHMMSS.sql.gz.gpg | gunzip | psql ..."
}

main "$@"
