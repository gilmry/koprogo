# s3cmd configuration for KoproGo off-site backups
# Generated by Ansible - do not edit by hand.
{% set provider = s3_provider | default('ovh') %}
{% set region = s3_region | default('gra') %}
{% if provider == 'ovh' %}
{%   set default_host = 's3.' ~ region ~ '.io.cloud.ovh.net' %}
{% elif provider == 'scaleway' %}
{%   set default_host = 's3.' ~ region ~ '.scw.cloud' %}
{% elif provider == 'backblaze' %}
{%   set default_host = 's3.' ~ region ~ '.backblazeb2.com' %}
{% else %}
{%   set default_host = 's3.' ~ region ~ '.amazonaws.com' %}
{% endif %}
{% set host = s3_host_base | default(default_host) %}

[default]
access_key = {{ s3_access_key }}
secret_key = {{ s3_secret_key }}
host_base = {{ host }}
host_bucket = {{ s3_host_bucket | default('%(bucket)s.' ~ host) }}
bucket_location = {{ region }}
use_https = True
signature_v2 = False

# Server-side encryption on top of the client-side GPG encryption
server_side_encryption = True

socket_timeout = 300
multipart_chunk_size_mb = 15
