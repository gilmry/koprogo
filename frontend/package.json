{
  "name": "koprogo-frontend",
  "type": "module",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "npm run generate:config && astro dev",
    "start": "astro dev",
    "build": "npm run generate:config && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate:config": "node scripts/generate-config.js",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --project=chromium --ui",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:e2e:debug": "playwright test --project=chromium --debug",
    "test:e2e:report": "playwright show-report",
    "test:characterization": "playwright test --project=characterization",
    "test:scenarios": "playwright test --project=scenarios",
    "test:scenarios:headed": "playwright test --project=scenarios --headed",
    "test:scenarios:debug": "playwright test --project=scenarios --debug",
    "test:all": "playwright test",
    "test:install": "playwright install chromium --with-deps",
    "codegen": "playwright codegen http://localhost",
    "codegen:mobile": "playwright codegen --device='iPhone 13' http://localhost",
    "docs:videos": "bash ../.claude/scripts/copy-videos.sh",
    "test:docs": "npm run test:e2e && npm run docs:videos",
    "types:generate": "openapi-typescript ../docs/api/openapi.json -o src/types/api.d.ts && prettier --write src/types/api.d.ts",
    "types:check": "npm run types:generate && git diff --exit-code src/types/api.d.ts",
    "test:unit:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.4",
    "@astrojs/svelte": "^9.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "svelte": "^5.57.0",
    "svelte-i18n": "^4.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.4.0",
    "@vite-pwa/astro": "^1.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "svelte-i18n": {
      "esbuild": "^0.25.0"
    },
    "lodash": "4.18.1",
    "defu": ">=6.1.5",
    "serialize-javascript": ">=7.0.3",
    "yaml": ">=2.8.3",
    "devalue": ">=5.8.1",
    "vite": "^8.0.13",
    "vite-plugin-pwa": "^1.3.0",
    "@vite-pwa/astro": {
      "astro": "^7.1.3"
    },
    "@babel/plugin-transform-modules-systemjs": "^7.29.7",
    "js-yaml": "^4.3.1"
  }
}
