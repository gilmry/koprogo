---
import Layout from "../../layouts/Layout.astro";
import BuildingList from "../../components/BuildingList.svelte";
import EnTeteDePage from "../../components/global/EnTeteDePage.svelte";
---

<Layout title="Immeubles - KoproGo">
  <main class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <EnTeteDePage
        client:load
        titre="pages.buildings.title"
        description="pages.buildings.description"
      />
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <BuildingList client:only="svelte" />
    </div>
  </main>
</Layout>
