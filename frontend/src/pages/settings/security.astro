---
import Layout from "../../layouts/Layout.astro";
import TwoFactorSettings from "../../components/settings/TwoFactorSettings.svelte";
---

<Layout title="Sécurité - KoproGo">
  <div class="container mx-auto px-4 py-8">
    <div class="max-w-3xl mx-auto">
      <a
        data-testid="security-settings-back-link"
        href="/settings"
        class="inline-flex items-center text-primary-600 hover:text-primary-700 mb-4"
        aria-label="Retour aux paramètres"
      >
        <svg
          class="w-5 h-5 mr-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Retour aux paramètres
      </a>

      <TwoFactorSettings client:load />
    </div>
  </div>
</Layout>
