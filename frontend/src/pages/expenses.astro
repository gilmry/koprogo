---
import Layout from "../layouts/Layout.astro";
import ExpenseList from "../components/ExpenseList.svelte";
import EnTeteDePage from "../components/global/EnTeteDePage.svelte";
---

<Layout title="Charges - KoproGo">
  <div class="container mx-auto px-4 py-8" data-testid="expenses-list">
    <div class="max-w-7xl mx-auto">
      <div class="mb-6">
        <EnTeteDePage
          client:load
          titre="pages.expenses.title"
          description="pages.expenses.description"
        />
      </div>

      <ExpenseList client:load />

      <div class="mt-6">
        <a
          data-testid="expenses-back-link"
          href="/syndic"
          class="inline-flex items-center text-primary-600 hover:text-primary-700"
        >
          <svg
            class="w-5 h-5 mr-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Retour au dashboard
        </a>
      </div>
    </div>
  </div>
</Layout>
