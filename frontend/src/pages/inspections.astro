---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Inspections techniques - KoproGo">
  <div class="container mx-auto px-4 py-8">
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-gray-900">Inspections techniques</h1>
      <p class="text-gray-600 mt-1">
        Suivi des contrôles réglementaires : ascenseurs, chaudières, installations électriques et plus
      </p>
    </div>

    <div id="building-selector-container" class="mb-6"></div>
    <div id="inspections-container"></div>
  </div>
</Layout>

<script>
  import { mount, unmount } from "svelte";
  import InspectionList from "../components/inspections/InspectionList.svelte";
  import BuildingSelector from "../components/BuildingSelector.svelte";
  import { authStore } from "../stores/auth";
  import { get } from "svelte/store";

  // organizationId n'était jamais passé à InspectionList, qui l'envoie
  // pourtant tel quel (string vide par défaut) dans CreateInspectionDto —
  // le backend l'exige en UUID valide (technical_inspection_use_cases.rs),
  // donc toute création échouait en 400 "Invalid organization_id format".
  // await authStore.init() nécessaire : silent-refresh async via cookie,
  // pattern déjà établi dans owner-contributions.astro/work-reports.astro.
  await authStore.init();
  const auth = get(authStore);
  const organizationId =
    auth.user?.organizationId || auth.user?.activeRole?.organizationId || "";

  const selectorContainer = document.getElementById("building-selector-container");
  const listContainer = document.getElementById("inspections-container");
  let listComponent: any = null;

  function mountList(buildingId: string) {
    if (!listContainer) return;
    if (listComponent) { try { unmount(listComponent); } catch {} }
    listContainer.innerHTML = "";
    listComponent = mount(InspectionList as any, {
      target: listContainer,
      props: { buildingId, organizationId, showHeader: false },
    });
  }

  if (selectorContainer) {
    mount(BuildingSelector as any, {
      target: selectorContainer,
      props: {
        label: "Immeuble",
        onSelect: (id: string) => mountList(id),
      },
    });
  }
</script>
