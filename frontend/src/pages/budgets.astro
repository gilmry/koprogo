---
import Layout from "../layouts/Layout.astro";
import BudgetList from "../components/budgets/BudgetList.svelte";
import EnTeteDePage from "../components/global/EnTeteDePage.svelte";
---

<Layout title="Budgets" showNav={true} requireAuth={true}>
  <div class="max-w-7xl mx-auto" data-testid="budgets-list">
    <div class="mb-6">
      <EnTeteDePage
        client:load
        titre="pages.budgets.title"
        description="pages.budgets.description"
      />
    </div>
    <BudgetList client:load />
  </div>
</Layout>
