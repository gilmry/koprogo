---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Sondages - KoproGo">
  <div class="container mx-auto px-4 py-8" data-testid="polls-list">
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-gray-900">
        🗳️ Sondages (Consultations)
      </h1>
      <p class="text-gray-600 mt-2">
        Consultez les copropriétaires entre les assemblées générales sur des
        décisions ponctuelles.
      </p>
      <div
        class="mt-4 p-4 bg-blue-50 border-l-4 border-blue-400 rounded-md text-sm"
      >
        <!-- Encadré volontairement SANS référence légale.
             Il citait « Article 577-8/4 §4 du Code Civil Belge » et affirmait que
             le syndic peut consulter les copropriétaires « sur toute décision ne
             nécessitant pas de vote formel en AG ». Deux problèmes signalés en
             recette le 2026-09-06 : la numérotation est antérieure à la réforme
             de 2020, et surtout le droit belge encadre étroitement la décision
             hors assemblée — le mécanisme le plus proche est la décision écrite
             à l'unanimité, nettement plus restrictif que ce qui était affirmé.
             Tant qu'un juriste n'a pas validé la base légale, mieux vaut
             présenter les sondages pour ce qu'ils sont : un outil de
             consultation informelle. Une fonctionnalité utile n'a pas besoin
             d'un article de loi pour exister. -->
        <p class="text-blue-800">
          <strong>ℹ️ Consultation informelle :</strong> les sondages recueillent l'avis
          des copropriétaires entre deux assemblées. Ils n'ont pas valeur de vote
          et ne remplacent aucune décision d'assemblée générale. Pour qu'un avis recueilli
          ici produise un effet, il doit être repris et voté en assemblée.
        </p>
      </div>
    </div>

    <div id="building-selector-container" class="mb-6"></div>
    <div id="poll-list-container"></div>
  </div>
</Layout>

<script>
  import { mount, unmount } from "svelte";
  import PollList from "../components/polls/PollList.svelte";
  import BuildingSelector from "../components/BuildingSelector.svelte";

  const selectorContainer = document.getElementById(
    "building-selector-container",
  );
  const listContainer = document.getElementById("poll-list-container");
  let listComponent: any = null;

  function mountList(buildingId: string) {
    if (!listContainer) return;
    if (listComponent) {
      try {
        unmount(listComponent);
      } catch {}
    }
    listContainer.innerHTML = "";
    listComponent = mount(PollList as any, {
      target: listContainer,
      props: {
        buildingId: buildingId,
        showOnlyActive: false,
      },
    });
  }

  if (selectorContainer) {
    mount(BuildingSelector as any, {
      target: selectorContainer,
      props: {
        label: "Immeuble",
        onSelect: (id: string) => mountList(id),
      },
    });
  }
</script>
