---
// Story 3.2 — Public consumption page for a MagicLink (/c/<token>).
// Story 3.3 — Wrap into an installable PWA (manifest + SW + 3-screen UX).
//
// Server-side fetch: GET /api/v1/c/<token> which atomically validates +
// consumes the token and returns the resolved scope payload. If the token
// is invalid / expired / already consumed, the backend returns 403 with the
// FR error message — we render an error card.
//
// Intentionally a Layout-less public page (no admin nav, no auth required).
//
// Story 3.3 specifics:
//   - `<link rel="manifest">` points at `/manifest.webmanifest` (scope /c/).
//   - Inline SW registration with `?v=<sw-version>` cache-bust.
//   - On the happy path we mount the Svelte 5 PWA component (3 screens +
//     IndexedDB draft); on the error path we still render the inline error
//     card so the contractor sees a clear FR message even without JS.

import { apiEndpoint } from "../../lib/config";
import MagicLinkContractorPage from "../../lib/components/pwa/MagicLinkContractorPage.svelte";

export const prerender = false;

// Keep in sync with `frontend/public/sw.js` SW_VERSION constant. Bumped at
// each release to invalidate stale caches (cf. apprentissage #549).
const SW_VERSION = "2026-06-07-1";

const { token } = Astro.params;

type ScopeKind = "ticket" | "quote" | "invoice" | "contractor_evaluation";

type ScopePayload = {
  scope_kind: ScopeKind;
  scope_id: string;
  scope: Record<string, unknown>;
};

let payload: ScopePayload | null = null;
let errorMessage: string | null = null;
let errorKind: string | null = null;

if (!token || typeof token !== "string") {
  errorMessage = "Lien invalide";
  errorKind = "magic_link_invalid";
} else {
  try {
    const res = await fetch(apiEndpoint(`/c/${encodeURIComponent(token)}`));
    if (res.ok) {
      payload = (await res.json()) as ScopePayload;
    } else {
      const body = await res.json().catch(() => ({}));
      errorMessage = (body?.error as string) ?? "Lien invalide";
      errorKind = (body?.kind as string) ?? "magic_link_invalid";
    }
  } catch (_err) {
    errorMessage = "Service indisponible";
    errorKind = "network_error";
  }
}
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0ea5e9" />
    <title>KoproGo — Accès partagé</title>

    <!-- Story 3.3: installable PWA scoped to /c/. The manifest declares
         `scope: "/c/"`, so installing this page from another route would
         fail — that's intentional (PWA contractor isolated from syndic UI). -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/pwa-192.png" />
  </head>
  <body class="bg-gray-50 min-h-screen">
    <main class="max-w-2xl mx-auto px-4 py-10">
      <header class="mb-6">
        <h1 class="text-2xl font-semibold text-gray-900">Accès partagé</h1>
        <p class="text-sm text-gray-500 mt-1">
          Vous consultez cette ressource via un lien magique sécurisé.
        </p>
      </header>

      {
        errorMessage && (
          <div
            class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-800"
            data-testid="c-page-error"
            data-error-kind={errorKind}
          >
            <p class="font-medium">{errorMessage}</p>
          </div>
        )
      }

      {
        payload && (
          <MagicLinkContractorPage
            client:load
            token={token!}
            scopeKind={payload.scope_kind}
            scope={payload.scope}
          />
        )
      }

      <footer class="mt-8 text-xs text-gray-400 text-center">
        <p>
          Ce lien est à usage unique et sera marqué comme consommé après cette
          consultation.
        </p>
      </footer>
    </main>

    <!-- Story 3.3 — register the contractor-scoped Service Worker. The
         `?v=<SW_VERSION>` query forces the browser HTTP cache to revalidate
         on a new release; once installed, `clients.claim()` activates the
         new SW immediately for open tabs. -->
    <script is:inline define:vars={{ SW_VERSION }}>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker
            .register(`/sw.js?v=${SW_VERSION}`, { scope: "/c/" })
            .catch(() => {
              // SW registration failure is non-fatal — the page still works
              // without offline support. Logged silently in production.
            });
        });
      }
    </script>
  </body>
</html>
