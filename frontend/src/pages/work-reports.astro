---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Rapports de travaux - KoproGo">
  <div class="container mx-auto px-4 py-8">
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-gray-900">Rapports de travaux</h1>
      <p class="text-gray-600 mt-1">
        Carnet d'entretien numérique : suivi des travaux, garanties et interventions
      </p>
    </div>

    <div id="building-selector-container" class="mb-6"></div>
    <div id="work-reports-container"></div>
  </div>
</Layout>

<script>
  import { mount, unmount } from "svelte";
  import WorkReportList from "../components/work-reports/WorkReportList.svelte";
  import BuildingSelector from "../components/BuildingSelector.svelte";
  import { authStore } from "../stores/auth";
  import { get } from "svelte/store";

  // `organizationId` n'était jamais passé au composant (prop par défaut ''),
  // donc chaque création de rapport envoyait `organization_id: ""` — rejeté
  // par le backend ("Invalid organization_id format"). Toute création de
  // rapport de travaux échouait, quel que soit l'immeuble sélectionné.
  await authStore.init();
  const auth = get(authStore);
  const organizationId =
    auth.user?.organizationId || auth.user?.activeRole?.organizationId || "";

  const selectorContainer = document.getElementById("building-selector-container");
  const listContainer = document.getElementById("work-reports-container");
  let listComponent: any = null;

  function mountList(buildingId: string) {
    if (!listContainer) return;
    if (listComponent) { try { unmount(listComponent); } catch {} }
    listContainer.innerHTML = "";
    listComponent = mount(WorkReportList as any, {
      target: listContainer,
      props: { buildingId, organizationId },
    });
  }

  if (selectorContainer) {
    mount(BuildingSelector as any, {
      target: selectorContainer,
      props: {
        label: "Immeuble",
        onSelect: (id: string) => mountList(id),
      },
    });
  }
</script>
