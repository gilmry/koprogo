---
import Layout from "../layouts/Layout.astro";

// L'inscription publique est fermée (#1155) : les comptes sont créés par
// l'administrateur. La page reste pour les anciens liens.
---

<Layout title="Inscription - KoproGo" showNav={false}>
  <div
    class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8"
  >
    <div class="max-w-md w-full space-y-8">
      <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10 text-center">
        <h1 class="text-2xl font-bold text-gray-900">
          Les inscriptions sont fermées
        </h1>
        <p class="mt-4 text-sm text-gray-600" data-testid="register-closed">
          Les comptes KoproGo sont créés par l'administrateur. Si vous avez déjà
          un compte, vous pouvez vous connecter.
        </p>
        <a
          data-testid="register-login-link"
          href="/login"
          class="mt-6 inline-block font-medium text-primary-600 hover:text-primary-500"
        >
          Se connecter
        </a>
      </div>
    </div>
  </div>
</Layout>
