# ============================================================================
# KoproGo Production Dockerfile
# Multi-stage build for minimal image size and optimal performance
# ============================================================================

# Stage 1a: base de construction, partagée par les deux stages suivants.
# Use nightly with Debian Bookworm base to match runtime GLIBC version
FROM rustlang/rust:nightly-bookworm-slim AS chef

WORKDIR /build

# Install build dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        pkg-config \
        libssl-dev \
        libpq-dev \
        curl && \
    rm -rf /var/lib/apt/lists/*

# cargo-chef sépare la compilation des dépendances de celle du code. Couche
# figée tant que l'image de base ne bouge pas.
RUN cargo install cargo-chef --locked

# Stage 1b: relevé des dépendances.
#
# `prepare` ne lit que les manifestes : la recette produite ne change que
# lorsque Cargo.toml ou Cargo.lock changent, pas à chaque modification de
# source. C'est ce qui permet à la couche suivante de rester en cache.
FROM chef AS planner

COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY benches ./benches

RUN cargo chef prepare --recipe-path recipe.json

# Stage 1c: construction.
#
# Avant ce découpage, tout était copié puis compilé d'un bloc : changer une
# ligne de source invalidait la couche et recompilait les ~100 dépendances,
# soit environ quinze minutes à chaque itération. Désormais `cook` compile
# les dépendances seules et reste en cache tant que Cargo.lock ne bouge pas ;
# seul le crate applicatif est recompilé.
FROM chef AS builder

# Set SQLx offline mode for Docker builds
ENV SQLX_OFFLINE=true

COPY --from=planner /build/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json

COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY benches ./benches
# `sqlx::migrate!` embarque les migrations à la compilation : elles doivent
# être présentes AVANT `cargo build`, pas seulement dans l'image finale.
COPY migrations ./migrations
COPY .sqlx ./.sqlx

# `tests/` n'est plus copié : `cargo build --release` ne le compile pas, et
# sa présence invalidait la couche à chaque modification d'un test.

# Build with optimizations (matching CLAUDE.md specs)
RUN cargo build --release && \
    strip target/release/koprogo-api

# Stage 2: Runtime
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libpq5 \
        libssl3 \
        curl && \
    rm -rf /var/lib/apt/lists/* && \
    # Create non-root user
    useradd -m -u 1000 koprogo && \
    chown -R koprogo:koprogo /app

# Copy binary from builder
COPY --from=builder /build/target/release/koprogo-api /app/koprogo-api

# Copy migrations for runtime
COPY --from=builder /build/migrations /app/migrations

# Create directories for uploads and logs
RUN mkdir -p /app/uploads /app/logs && \
    chown -R koprogo:koprogo /app/uploads /app/logs

# Switch to non-root user
USER koprogo

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/api/v1/health || exit 1

# Set environment defaults
ENV RUST_LOG=info \
    RUST_BACKTRACE=0 \
    SERVER_HOST=0.0.0.0 \
    SERVER_PORT=8080

# Run the application
CMD ["/app/koprogo-api"]
