DATABASE_URL=postgresql://koprogo:koprogo123@localhost:5432/koprogo_db
JWT_SECRET=your-secret-key-change-this-in-production
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ========================================
# Logging Configuration (Issue #78)
# ========================================
# Log level: error, warn, info, debug, trace
RUST_LOG=info

# Log format: json (production) or text (development)
# - json: Structured JSON logs for machine parsing and log aggregation (ELK, Datadog, etc.)
# - text: Human-readable colored logs for local development
# Default: text
LOG_FORMAT=text

SERVER_HOST=127.0.0.1
SERVER_PORT=8080
UPLOAD_DIR=./uploads
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4321

# WP-FE1 — Refresh token cookie (HttpOnly; SameSite=Strict).
# COOKIE_SECURE=true en PROD (HTTPS obligatoire — défaut sûr si non défini).
# Mettre false UNIQUEMENT en dev/E2E sur http://localhost (sinon le
# navigateur rejette le cookie hors HTTPS).
COOKIE_SECURE=true

# ========================================
# Rate Limiting Configuration (Issue #78)
# ========================================
# IP-based rate limiting (public endpoints + /auth/login brute-force
# protection) is enforced by Traefik middlewares, not this application — see
# the `traefik.http.middlewares.*.ratelimit.*` labels in docker-compose.yml /
# docker-compose.prod.yml and infrastructure/_shared/kustomize/base/ingress.yaml.
#
# ENABLE_RATE_LIMITING here only gates the GDPR export endpoints' per-user
# rate limit (10 requests/hour), which depends on the authenticated JWT
# identity and can't be enforced by Traefik.
#
# IMPORTANT: Set to false ONLY for load testing - NEVER disable in production!
# Default: true (enabled)
ENABLE_RATE_LIMITING=true
#
# When disabled, the GDPR rate limiter is set to effectively unlimited.
# Use only for:
# - Local development with high-frequency automated testing
# - Load testing / benchmarking
# - Never in staging or production environments

# SMTP Email Configuration (GDPR notifications)
# Set SMTP_ENABLED=false to disable email sending (emails will be logged only)
SMTP_ENABLED=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=noreply@koprogo.com
# SMTP_FROM_NAME=KoproGo
