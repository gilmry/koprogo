{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT uo.unit_id, uo.owner_id, uo.ownership_percentage,\n                   u.quota AS unit_quota,\n                   b.total_tantiemes\n            FROM unit_owners uo\n            JOIN units u ON uo.unit_id = u.id\n            JOIN buildings b ON u.building_id = b.id\n            WHERE u.building_id = $1 AND uo.end_date IS NULL\n            ",
