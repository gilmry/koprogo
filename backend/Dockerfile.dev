# Development Dockerfile with hot reload (cargo-watch)
# Use nightly to match production build
FROM rustlang/rust:nightly-bookworm-slim

WORKDIR /app

# Pin the nightly toolchain to a known-good date. The floating `nightly` tag
# pulled by the base image is a moving target: `nightly-2026-07-24` shipped a
# codegen ICE (`internal compiler error: not immediate: OperandRef(Uninit ...)`)
# that crashes compiling `tokio` during `cargo install sqlx-cli` below, making
# the whole dev image un-buildable. `nightly-2026-07-20` compiles tokio cleanly.
# Bump this date deliberately (and rebuild to verify) rather than floating.
RUN rustup toolchain install nightly-2026-07-20 --profile minimal && \
    rustup default nightly-2026-07-20

# Install rustfmt and clippy for the pinned nightly toolchain
RUN rustup component add rustfmt clippy

# Install system dependencies FIRST (needed for sqlx-cli build)
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install dev tools (after system deps so openssl-sys can build)
RUN cargo install cargo-watch && \
    cargo install sqlx-cli --no-default-features --features native-tls,postgres && \
    cargo install cargo-audit && \
    cargo install cargo-llvm-cov

# `llvm-tools-preview` fournit llvm-profdata/llvm-cov, requis par cargo-llvm-cov.
RUN rustup component add llvm-tools-preview

# Copy Cargo files for dependency caching
COPY Cargo.toml Cargo.lock ./

# Create dummy main and test files to cache dependencies
# IMPORTANT: every [[test]] entry in Cargo.toml needs a placeholder file here
# (or Cargo fails to parse the manifest before `cargo build`). When adding a
# new harness, add its placeholder line below — slice 1 (Story 1.1+) added
# bdd_acp, bdd_list_buildings_role_based, bdd_building_conformity ;
# slice 2 (Story 2.1) adds bdd_portfolio ; Track H adds bdd_validate_before_compute,
# bdd_meeting_complete, bdd_voting_right + integration buildings_runtime_test.
RUN mkdir -p src tests tests/integration benches && \
    echo "fn main() {}" > src/main.rs && \
    echo "fn main() {}" > tests/bdd.rs && \
    echo "fn main() {}" > tests/bdd_governance.rs && \
    echo "fn main() {}" > tests/bdd_financial.rs && \
    echo "fn main() {}" > tests/bdd_operations.rs && \
    echo "fn main() {}" > tests/bdd_community.rs && \
    echo "fn main() {}" > tests/bdd_iot.rs && \
    echo "fn main() {}" > tests/bdd_acp.rs && \
    echo "fn main() {}" > tests/bdd_list_buildings_role_based.rs && \
    echo "fn main() {}" > tests/bdd_building_conformity.rs && \
    echo "fn main() {}" > tests/bdd_portfolio.rs && \
    echo "fn main() {}" > tests/bdd_validate_before_compute.rs && \
    echo "fn main() {}" > tests/bdd_meeting_complete.rs && \
    echo "fn main() {}" > tests/bdd_voting_right.rs && \
    echo "fn main() {}" > tests/integration/acp_test.rs && \
    echo "fn main() {}" > tests/integration/migration_acp_backfill_test.rs && \
    echo "fn main() {}" > tests/integration/buildings_runtime_test.rs && \
    echo "fn main() {}" > benches/load_tests.rs && \
    cargo build && \
    rm -rf src tests benches

# Source code will be mounted via volume

# Hot reload command: watch for changes and rebuild
CMD cargo watch -x "run --bin koprogo-api"
